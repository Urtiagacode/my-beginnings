import random
import os

france = {
    "ressources": 500,
    "or": 300,
    "bonheur": 50,
    "puissance": 100,
    "intelligence": 0,
    "fermes": 0,
    "camps_militaires": 0,
    "parcs_attraction": 0,
    "universites": 0,
    "mines": 0,
    "allie": None,
    "demande_allie": False
}

belgique = {
    "ressources": 500,
    "or": 300,
    "bonheur": 50,
    "puissance": 75,
    "intelligence": 0,
    "fermes": 0,
    "camps_militaires": 0,
    "parcs_attraction": 0,
    "universites": 0,
    "mines": 0,
    "allie": None,
    "demande_allie": False,
    "profil": random.choice(["Militaire", "Scientifique", "Économique"])
}

tour = 1

def nettoyer_ecran():
    os.system('cls' if os.name == 'nt' else 'clear')

def jouer_tour_ia(ia, joueur, nom_ia, nom_joueur, prix_marche):
    print(f"\n[IA] Tour de la Belgique ({ia['profil']})...")
    
    puissance_ia_reelle = ia["puissance"] + (ia["intelligence"] // 2)
    puissance_joueur_reelle = joueur["puissance"] + (joueur["intelligence"] // 2)

    seuil_guerre = 30 if ia["profil"] == "Militaire" else 60
    if puissance_ia_reelle > puissance_joueur_reelle + seuil_guerre and ia["allie"] != nom_joueur:
        print(f"⚠️ GUERRE : L'IA vous déclare la guerre !")
        jet_ia = random.randint(1, 20)
        jet_joueur = random.randint(1, 20)
        
        if (puissance_ia_reelle + jet_ia) > (puissance_joueur_reelle + jet_joueur):
            pillage_res = joueur["ressources"] // 2
            pillage_or = joueur["or"] // 2
            print(f"❌ Victoire de l'IA ! Elle a pillé {pillage_res} ressources et {pillage_or} pièces d'or.")
            ia["ressources"] += pillage_res; joueur["ressources"] -= pillage_res
            ia["or"] += pillage_or; joueur["or"] -= pillage_or
            joueur["bonheur"] = max(0, joueur["bonheur"] - 20)
        else:
            print(f"🎉 Vous avez repoussé l'attaque de l'IA ! Son armée bat en retraite.")
            ia["bonheur"] = max(0, ia["bonheur"] - 15)
        return True

    if ia["profil"] == "Économique" and ia["ressources"] >= 550:
        ia["ressources"] -= 550; ia["mines"] += 1
        print("L'IA a construit une Mine pour booster son économie.")
        return True
    elif ia["profil"] == "Scientifique" and ia["ressources"] >= 350:
        ia["ressources"] -= 350; ia["universites"] += 1
        print("L'IA a construit une Université pour booster sa science.")
        return True
    elif ia["profil"] == "Militaire" and ia["ressources"] >= 250:
        ia["ressources"] -= 250; ia["camps_militaires"] += 1
        print("L'IA a construit un Camp militaire pour renforcer ses troupes.")
        return True

    if ia["ressources"] >= 300 and ia["fermes"] < 2:
        ia["ressources"] -= 300; ia["fermes"] += 1
        print("L'IA a construit une Ferme.")
        return True
    elif ia["ressources"] >= 400 and ia["bonheur"] < 40:
        ia["ressources"] -= 400; ia["parcs_attraction"] += 1
        print("L'IA a construit un Parc d'attraction.")
        return True

    if joueur["demande_allie"]:
        chance_acceptation = 70 if ia["bonheur"] >= 50 else 40
        if random.randint(1, 100) <= chance_acceptation:
            ia["allie"], joueur["allie"] = nom_joueur, nom_ia
            joueur["demande_allie"] = False
            ia["bonheur"] += 15; joueur["bonheur"] += 15
            print("🤝 L'IA a accepté votre demande d'alliance ! (+15 bonheur chacun)")
        else:
            joueur["demande_allie"] = False
            print("❌ L'IA a décliné votre demande d'alliance.")
        return True

    print("L'IA décide d'économiser ses ressources ce tour-ci.")
    return True

nettoyer_ecran()
print("=============================================")
print("  Mini jeu par Urtiaga   ")
print("=============================================")
print(f"L'IA de la Belgique a adopté un profil : {belgique['profil']}\n")

while True:
    if tour > 20 or france["ressources"] <= 0 and france["or"] <= 0 or belgique["ressources"] <= 0 and belgique["or"] <= 0:
        print("\n=================== FIN DU JEU ===================")
        score_france = france["ressources"] + france["or"] + (france["puissance"] * 2) + (france["intelligence"] * 3)
        score_belgique = belgique["ressources"] + belgique["or"] + (belgique["puissance"] * 2) + (belgique["intelligence"] * 3)
        
        print(f"Score France (Vous) : {score_france} points")
        print(f"Score Belgique (IA) : {score_belgique} points")
        
        if score_france > score_belgique:
            print("👑 VICTOIRE ÉCLATANTE DE LA FRANCE !")
        elif score_france < score_belgique:
            print("🇧🇪 VICTOIRE DE LA BELGIQUE ! L'IA vous a surpassé.")
        else:
            print("🤝 Égalité parfaite entre les deux nations.")
        break

    prix_marche = round(random.uniform(0.8, 1.5), 2)
    
    if random.randint(1, 100) <= 15:
        print("\n⚡ [ÉVÉNEMENT ALÉATOIRE]")
        pays_event = random.choice(["france", "belgique"])
        pays_info = france if pays_event == "france" else belgique
        nom_pays = "La France (Vous)" if pays_event == "france" else "La Belgique (IA)"
        
        type_event = random.randint(1, 4)
        if type_event == 1:
            pays_info["ressources"] += 150
            print(f"⛏️ Nouveau gisement trouvé pour {nom_pays} ! +150 ressources.")
        elif type_event == 2:
            pays_info["ressources"] = max(0, pays_info["ressources"] - 100)
            print(f"🌪️ Catastrophe naturelle sur {nom_pays} ! -100 ressources.")
        elif type_event == 3:
            pays_info["bonheur"] = max(0, pays_info["bonheur"] - 20)
            print(f"📢 Grève générale chez {nom_pays} ! -20 bonheur.")
        elif type_event == 4:
            pays_info["or"] += 200
            print(f"💰 Boom économique chez {nom_pays} ! +200 Or.")

    print(f"\n--- Tour {tour} / 20 ---")
    print(f"📈 Prix actuel du marché : 1 Ressource = {prix_marche} Or")
    print("1. 👀 Voir l'état des deux pays")
    print("2. ✋ Demander de l'Or à l'IA")
    print("3. ⚔️ Faire la guerre à l'IA")
    print("4. 🏗️ Construire un bâtiment")
    print("5. 💱 Faire du commerce (Marché Or/Ressources)")
    print("6. 🤝 Proposer une Alliance")
    print("7. 💤 Passer son tour")
    print("q. 🛑 Quitter le jeu")

    choix = input("Votre action : ").strip().lower()
    action_joueur_faite = False

    if choix == "1":
        print(f"\n[VOUS] France   -> Ressources: {france['ressources']} | Or: {france['or']} | Bonheur: {france['bonheur']}% | Puissance: {france['puissance']} | Intelligence: {france['intelligence']}\n        Bâtiments: Fermes({france['fermes']}) Mines({france['mines']}) Camps({france['camps_militaires']}) Parcs({france['parcs_attraction']}) Universités({france['universites']})")
        print(f"[IA]   Belgique -> Ressources: {belgique['ressources']} | Or: {belgique['or']} | Bonheur: {belgique['bonheur']}% | Puissance: {belgique['puissance']} | Intelligence: {belgique['intelligence']}\n        Bâtiments: Fermes({belgique['fermes']}) Mines({belgique['mines']}) Camps({belgique['camps_militaires']}) Parcs({belgique['parcs_attraction']}) Universités({belgique['universites']})")
        print(f"🔗 Alliance active : {france['allie'] if france['allie'] else 'Aucune'}")
        input("\nAppuyez sur Entrée pour continuer...")
        continue
        
    elif choix == "2":
        if belgique["or"] >= 100:
            if france["allie"] == "belgique" and random.randint(1, 2) == 1:
                belgique["or"] -= 100; france["or"] += 100
                print("💰 Votre allié belge accepte de vous soutenir et vous donne 100 Or !")
            else:
                print("❌ L'IA refuse de vous donner de l'argent. Elle garde ses fonds ou vous n'êtes pas alliés.")
        else:
            print("L'IA est trop pauvre pour vous aider.")
        action_joueur_faite = True

    elif choix == "3":
        if france["allie"] == "belgique":
            print("Vous êtes alliés ! Trahir une alliance est impossible dans cette version.")
        else:
            print("⚔️ Vous lancez l'assaut !")
            p_j = france["puissance"] + (france["intelligence"] // 2)
            p_ia = belgique["puissance"] + (belgique["intelligence"] // 2)
            
            jet_joueur = random.randint(1, 25)
            jet_ia = random.randint(1, 25)
            
            if (p_j + jet_joueur) > (p_ia + jet_ia):
                pillage = belgique["ressources"] // 2
                print(f"🎉 Victoire ! Vos armées écrasent la Belgique et pillent {pillage} ressources.")
                france["ressources"] += pillage; belgique["ressources"] -= pillage
                belgique["bonheur"] = max(0, belgique["bonheur"] - 20)
            else:
                pillage = france["ressources"] // 3
                print(f"💥 Échec sanglant ! L'IA repousse vos assauts et contre-attaque. Vous perdez {pillage} ressources.")
                belgique["ressources"] += pillage; france["ressources"] -= pillage
                france["bonheur"] = max(0, france["bonheur"] - 20)
            action_joueur_faite = True

    elif choix == "4":
        print(f"\nVos ressources actuelles : {france['ressources']}")
        print("1. Ferme (300 res) | 2. Camp militaire (250 res) | 3. Parc d'attraction (400 res) | 4. Université (350 res) | 5. Mine (550 res)")
        bat = input("Quel bâtiment voulez-vous construire ? ")
        if bat == "1" and france["ressources"] >= 300:
            france["ressources"] -= 300; france["fermes"] += 1; print("Ferme construite !"); action_joueur_faite = True
        elif bat == "2" and france["ressources"] >= 250:
            france["ressources"] -= 250; france["camps_militaires"] += 1; print("Camp militaire construit !"); action_joueur_faite = True
        elif bat == "3" and france["ressources"] >= 400:
            france["ressources"] -= 400; france["parcs_attraction"] += 1; print("Parc d'attraction construit !"); action_joueur_faite = True
        elif bat == "4" and france["ressources"] >= 350:
            france["ressources"] -= 350; france["universites"] += 1; print("Université construite !"); action_joueur_faite = True
        elif bat == "5" and france["ressources"] >= 550:
            france["ressources"] -= 550; france["mines"] += 1; print("Mine construite !"); action_joueur_faite = True
        else:
            print("Ressources insuffisantes ou mauvais choix.")

    elif choix == "5":
        act = input("Voulez-vous Acheter des ressources (a) ou Vendre vos ressources (v) ? ").lower()
        qty = int(input("Quelle quantité de ressources ? "))
        cout_or = int(qty * prix_marche)
        
        if act == "a":
            if france["or"] >= cout_or and belgique["ressources"] >= qty:
                france["or"] -= cout_or; france["ressources"] += qty
                belgique["or"] += cout_or; belgique["ressources"] -= qty
                print(f"🛒 Achat réussi ! Vous avez payé {cout_or} Or pour {qty} ressources."); action_joueur_faite = True
            else:
                print("Transaction impossible : Pas assez d'Or ou l'IA n'a pas assez de ressources.")
        elif act == "v":
            if france["ressources"] >= qty and belgique["or"] >= cout_or:
                france["ressources"] -= qty; france["or"] += cout_or
                belgique["ressources"] += qty; belgique["or"] -= cout_or
                print(f"💰 Vente réussie ! Vous avez vendu {qty} ressources pour {cout_or} Or."); action_joueur_faite = True
            else:
                print("Transaction impossible : Vous manquez de ressources ou l'IA n'a plus d'Or.")

    elif choix == "6":
        if france["allie"] is not None:
            print("Vous êtes déjà alliés.")
        else:
            france["demande_allie"] = True
            print("Demande d'alliance envoyée à la Belgique.")
            action_joueur_faite = True

    elif choix == "7":
        print("Vous passez votre tour pour accumuler vos bonus.")
        action_joueur_faite = True

    elif choix == "q":
        print("Honte a toi pauvre fou !")
        break
    else:
        print("Choix invalide.")

    if action_joueur_faite:
        jouer_tour_ia(belgique, france, "belgique", "france", prix_marche)

        for pays in [france, belgique]:
            if pays["bonheur"] < 25: 
                pays["ressources"] = max(0, pays["ressources"] - 20)
                print("📉 Faible bonheur : Des ouvriers font grève (perte de ressources).")
            elif pays["bonheur"] >= 75: 
                pays["ressources"] += 20
                print("📈 Bonheur élevé : Productivité en hausse ! (+20 ressources).")
            
            coût_maintenance = (pays["camps_militaires"] * 5) + (pays["universites"] * 5)
            pays["or"] = max(0, pays["or"] - coût_maintenance)

        for pays, nom in [(france, "La France"), (belgique, "L'IA")]:
            if pays["fermes"] > 0 or pays["camps_militaires"] > 0 or pays["parcs_attraction"] > 0 or pays["universites"] > 0 or pays["mines"] > 0:
                b_res = (pays["fermes"] * 35) + (pays["mines"] * 60)
                b_pui = pays["camps_militaires"] * 15
                b_bon = pays["parcs_attraction"] * 10
                b_int = pays["universites"] * 20
                
                pays["ressources"] += b_res
                pays["puissance"] += b_pui
                pays["bonheur"] = min(100, pays["bonheur"] + b_bon)
                pays["intelligence"] += b_int
                print(f"🏭 Production {nom} : +{b_res} Res | +{b_pui} Puiss | +{b_bon} Bonheur | +{b_int} Intel")

        if france["allie"] == "belgique":
            france["ressources"] += 30
            belgique["ressources"] += 30
            france["or"] += 10
            belgique["or"] += 10
            print("🤝 Bonus de Coopération de l'Alliance : +30 ressources et +10 Or chacun.")

        tour += 1
        input("\nFin du tour. Appuyez sur Entrée pour passer au tour suivant...")
        nettoyer_ecran()
